# Copy to .env. Values: Supabase Dashboard → Project Settings → API Keys.
# Server-only: all Supabase access goes through API routes. Never prefix these with NEXT_PUBLIC_.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only: guards /api/trials/sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
