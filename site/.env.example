# Copy to .env. Values: Supabase Dashboard → Project Settings → API Keys.
# Server-only: all Supabase access goes through API routes. Never prefix these with NEXT_PUBLIC_.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Server-only: guards /api/trials/sync (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Server-only: the outreach caller (voice-agent/). Accepting a trial on its page starts Ava's calls.
# CALLER_API_KEY is the caller's READ_API_KEY. CALLER_PUBLIC_URL is where staff open its dashboard.
# On Vercel, CALLER_URL comes from the service binding in vercel.json and CALLER_PUBLIC_URL can stay unset; don't set either there.
CALLER_URL=http://127.0.0.1:8000
CALLER_API_KEY=
CALLER_PUBLIC_URL=

# Server-only, matcher and criteria scripts (site/scripts/). Jev runs on OpenRouter; Gemini runs on its own key.
# The scripts read the repo-root .env (../.env from site/), so put these there too.
OPENROUTER_KEY=
GEMINI_API_KEY=
