# Copy to .env. With MOCK_MODE=true nothing leaves your machine and no keys are needed.
MOCK_MODE=true

# Public HTTPS URL of this server (a tunnel), so ElevenLabs can reach /tools and /webhooks.
#   cloudflared tunnel --url http://localhost:8000
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

# ElevenLabs (API key needs: agents, tools, secrets, conversations, phone numbers; webhooks optional)
ELEVENLABS_API_KEY=
# Optional overrides:
# ELEVENLABS_LLM=claude-sonnet-5-5
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Twilio (trial is fine: only verified numbers can be called/texted)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Written by scripts/setup_elevenlabs.py, don't fill these by hand:
# TOOL_SECRET=  READ_API_KEY=  ELEVENLABS_AGENT_ID=  ELEVENLABS_PHONE_NUMBER_ID=  ELEVENLABS_WEBHOOK_SECRET=
